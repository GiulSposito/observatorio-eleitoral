/web/_site/
/web/.quarto/
/web/data/
.quarto/
/docs/*_files/
/docs/*.html

# E2E tooling (tests/e2e is the only npm project; lockfile is tracked)
node_modules/
/tests/e2e/test-results/
/tests/e2e/playwright-report/
/tests/e2e/blob-report/
/tests/e2e/.cache/

# Local Claude Code settings (project skills in .claude/skills are tracked)
.claude/settings.local.json

# Secrets and local env
.env
.env.*
.Renviron

# OS / editors
.DS_Store
Thumbs.db
*.swp

# Claude Code subagent worktrees (temporary)
/.claude/worktrees/

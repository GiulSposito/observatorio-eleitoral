# R / RStudio
.Rproj.user/
.Rhistory
.RData
.Ruserdata

# renv (lockfile is tracked, library is not)
renv/library/
renv/staging/
renv/local/
renv/python/

# targets cache
_targets/

# Data layers and releases: bronze/silver/gold/releases (see docs/arquitetura.md)
/data/


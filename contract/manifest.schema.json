{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "manifest.schema.json",
  "type": "object",
  "required": ["schema_version","release_id","election_id","municipio_tse","uf","name","generated_at","validation_status","features","assets","sources","pipeline_git_sha","method_version"],
  "additionalProperties": false,
  "properties": {
    "schema_version": {"$ref": "common.schema.json#/definitions/schema_version"},
    "release_id": {"$ref": "common.schema.json#/definitions/release_id"},
    "election_id": {"$ref": "common.schema.json#/definitions/election_id"},
    "municipio_tse": {"$ref": "common.schema.json#/definitions/municipio_tse"},
    "uf": {"$ref": "common.schema.json#/definitions/uf"},
    "name": {"type": "string", "minLength": 1},
    "generated_at": {"$ref": "common.schema.json#/definitions/timestamp"},
    "validation_status": {"$ref": "common.schema.json#/definitions/validation_status"},
    "features": {
      "type": "object",
      "required": ["summary","sections","bounds","scenarios","ecological_model"],
      "additionalProperties": false,
      "properties": {
        "summary": {"$ref": "common.schema.json#/definitions/feature_status"},
        "sections": {"$ref": "common.schema.json#/definitions/feature_status"},
        "bounds": {"$ref": "common.schema.json#/definitions/feature_status"},
        "scenarios": {"$ref": "common.schema.json#/definitions/feature_status"},
        "ecological_model": {"$ref": "common.schema.json#/definitions/feature_status"}
      }
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "summary": {"$ref": "common.schema.json#/definitions/asset"},
        "quality": {"$ref": "common.schema.json#/definitions/asset"},
        "sections": {"$ref": "common.schema.json#/definitions/asset"},
        "bounds": {"$ref": "common.schema.json#/definitions/asset"},
        "scenarios": {"$ref": "common.schema.json#/definitions/asset"},
        "flows": {"$ref": "common.schema.json#/definitions/asset"}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["provider","dataset","file","source_url","collected_at","source_sha256","bytes"],
        "additionalProperties": false,
        "properties": {
          "provider": {"type": "string"},
          "dataset": {"type": "string"},
          "file": {"type": "string"},
          "source_url": {"type": ["string","null"], "pattern": "^https://"},
          "collected_at": {"anyOf": [{"$ref": "common.schema.json#/definitions/timestamp"}, {"type": "null"}]},
          "source_sha256": {"anyOf": [{"$ref": "common.schema.json#/definitions/sha256"}, {"type": "null"}]},
          "bytes": {"type": ["integer","null"], "minimum": 0}
        }
      }
    },
    "pipeline_git_sha": {"$ref": "common.schema.json#/definitions/git_sha"},
    "method_version": {"$ref": "common.schema.json#/definitions/method_version"}
  }
}
